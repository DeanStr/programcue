{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main",
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.cjs",
      "**/*.css",
      "**/*.js",
      "**/*.json",
      "**/*.jsonc",
      "**/*.mjs",
      "**/*.ts",
      "**/*.tsx",
      "!package-lock.json",
      "!public/openapi.json",
      "!!**/.react-router",
      "!!**/.wrangler",
      "!!**/.artifacts",
      "!!**/build",
      "!!**/coverage",
      "!!**/node_modules",
      "!!**/playwright-report",
      "!!**/test-results",
    ],
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Explicit pre-adoption debt. Remove entries in focused, tested batches.
      "a11y": {
        "noNoninteractiveTabindex": "off",
        "useSemanticElements": "off",
      },
      "complexity": {
        "noImportantStyles": "off",
        "noStaticOnlyClass": "off",
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConfusingVoidType": "off",
        "noDocumentCookie": "off",
        "noExplicitAny": "off",
      },
    },
  },
  "assist": {
    "enabled": true,
  },
  "overrides": [
    {
      "includes": ["**/*.jsonc"],
      "json": {
        "formatter": {
          "trailingCommas": "all",
        },
      },
    },
  ],
}
