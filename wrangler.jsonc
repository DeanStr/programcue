{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "program-cue",
  "main": "workers/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app.programcue.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "program-cue-db",
      "database_id": "e272bd36-0f62-435e-b7bb-2e2995dedf34",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "program-cue-files",
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "program-cue-d1-backups",
    },
  ],
  "ai": { "binding": "AI" },
  "workflows": [
    {
      "name": "program-cue-d1-backup",
      "binding": "D1_BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_CHANNEL",
        "class_name": "EventChannel",
      },
      {
        "name": "PROGRAM_CUE_AGENT",
        "class_name": "ProgramCueEventAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventChannel"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProgramCueEventAgent"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OPERATIONS_QUEUE",
        "queue": "program-cue-operations",
      },
    ],
    "consumers": [
      {
        "queue": "program-cue-operations",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "program-cue-operations-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *", "17 2 * * *"],
  },
  "vars": {
    "APP_ENV": "production",
    "DEMO_MODE": "false",
    "EVALUATION_MODE": "true",
    "SOURCE_REVISION": "d0dd6a5808757a712914c9fd62bbc37718b2396f",
    "BETTER_AUTH_URL": "https://app.programcue.com",
    "AUTH_EMAIL_FROM": "Program Cue <auth@programcue.com>",
    "EMAIL_PROVIDER": "resend",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAENJ1zg5h3WGnYdU",
    "CLOUDFLARE_ACCOUNT_ID": "327c60945460c16be8ecdbbc7fa35447",
    "D1_DATABASE_ID": "e272bd36-0f62-435e-b7bb-2e2995dedf34",
    "R2_ACCOUNT_ID": "327c60945460c16be8ecdbbc7fa35447",
    "R2_BUCKET_NAME": "program-cue-files",
    "FILE_SCANNER_API_URL": "https://scanner.programcue.com/v1/scans",
    "CORS_ALLOWED_ORIGINS": "https://app.programcue.com",
    "EMBED_FRAME_ANCESTORS": "https://app.programcue.com https://programcue.com https://www.programcue.com",
    "RESOURCE_EMBED_ORIGINS": "none",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "upload_source_maps": true,
}
