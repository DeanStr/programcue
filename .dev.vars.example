# Required locally for signed application notices and authentication. Generate a unique 32+ character value.
BETTER_AUTH_SECRET=

# Optional remote provider credentials for the corresponding local workflow.
# Base64-encoded 32-byte AES-GCM key used only to decrypt connected-calendar OAuth envelopes.
CALENDAR_CREDENTIALS_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
MICROSOFT_AUTH_CLIENT_ID=
MICROSOFT_AUTH_CLIENT_SECRET=
# Base64-encoded 32-byte AES-GCM key for external integration credentials.
INTEGRATION_CREDENTIALS_KEY=
# Base64-encoded 32-byte AES-GCM key for outbound webhook credentials.
WEBHOOK_CREDENTIALS_KEY=
FILE_SCANNER_WEBHOOK_SECRET=
FILE_SCANNER_API_URL=
FILE_SCANNER_API_TOKEN=
# Direct multipart upload uses the real R2 S3 endpoint and is intentionally unavailable without these values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
# Optional provider-compatible endpoint overrides. Leave blank for the official APIs.
OPENAI_RESPONSES_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MESSAGES_URL=
