{
  "extends": "./tsconfig.json",
  "include": [
    "*.config.ts",
    "vitest.test-files.ts",
    "scanner/src/contract.ts",
    "scanner/src/contract.test.ts",
    "e2e/**/*.ts",
    "site/e2e/**/*.ts",
    "site/*.ts",
    "scripts/**/*.ts",
    "app/**/*.lint.ts"
  ],
  "exclude": ["scripts/emit-openapi-schemas.ts"],
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
