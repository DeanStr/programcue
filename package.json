{
  "name": "program-cue",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Conference programme operations platform built as a React Router and Cloudflare Workers modular monolith.",
  "scripts": {
    "build": "react-router build",
    "dev": "npm run db:migrate:local && react-router dev",
    "start": "npm run dev",
    "preview": "npm run build && vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "quality": "biome check .",
    "quality:fix": "biome check --write .",
    "quality:ci": "biome ci .",
    "types:generate": "wrangler types && react-router typegen",
    "typecheck:generated": "tsc -p tsconfig.node.json && tsc -p tsconfig.cloudflare.json",
    "typecheck": "npm run types:generate && npm run typecheck:generated",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "npm run test:worker:runtime && npm run test:agent",
    "test:worker:runtime": "vitest run --config vitest.worker.config.ts",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "test:changed": "vitest run --config vitest.focused.config.ts --changed=main --passWithNoTests",
    "test:related": "vitest related --config vitest.focused.config.ts --run --passWithNoTests",
    "test:scanner": "python3 -m unittest discover -s scanner/tests -p 'test_*.py'",
    "security:dependencies": "npm audit --audit-level=high",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:worker:watch": "vitest --config vitest.worker.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:serial": "npm run build && playwright test",
    "test:e2e:update": "node scripts/run-e2e.mjs --update-snapshots",
    "test:site:e2e": "playwright test --config=site/playwright.config.ts",
    "test:site:e2e:update": "playwright test --config=site/playwright.config.ts --update-snapshots",
    "performance:local": "npm run build && PERFORMANCE_EVIDENCE=1 playwright test e2e/performance.spec.ts --project=desktop-chromium",
    "dev:e2e": "node scripts/prepare-e2e.mjs --skip-build && react-router dev --mode e2e",
    "serve:e2e": "node scripts/prepare-e2e.mjs && node scripts/serve-e2e-worker.mjs",
    "serve:e2e:prepared": "node scripts/prepare-e2e.mjs --skip-build && node scripts/serve-e2e-worker.mjs",
    "openapi:sync": "node scripts/validate-openapi.mjs --write",
    "openapi:check": "node scripts/validate-openapi.mjs",
    "deploy:check": "node scripts/validate-deploy-config.mjs && node scripts/validate-scanner-config.mjs && node scripts/validate-site-config.mjs",
    "deploy:state": "node scripts/validate-release-state.mjs",
    "deploy:secrets": "node scripts/validate-deploy-secrets.mjs",
    "deploy:ledger": "node scripts/validate-remote-schema.mjs --before-migrate",
    "deploy:schema": "node scripts/validate-remote-schema.mjs",
    "deploy:smoke": "node scripts/verify-production-health.mjs",
    "test:config": "node --test scripts/*.test.mjs",
    "check": "node scripts/run-checks.mjs --full",
    "check:core": "node scripts/run-checks.mjs --core",
    "check:quick": "node scripts/run-checks.mjs --quick",
    "check:browser:pr": "node scripts/run-pr-browser-checks.mjs",
    "check:focused": "npm run quality:ci && npm run typecheck:generated && npm run test:changed",
    "deploy": "npm run check && npm run deploy:preflight && npm run db:migrate:remote && npm run deploy:cutover && npm run deploy:smoke",
    "deploy:preflight": "npm run deploy:check && npm run deploy:state && npm run deploy:secrets && npm run deploy:ledger",
    "deploy:cutover": "npm run deploy:schema && node scripts/deploy-production.mjs",
    "deploy:scanner": "npm run test:scanner && wrangler deploy -c scanner/wrangler.jsonc",
    "deploy:site": "node scripts/validate-site-config.mjs && wrangler deploy -c site/wrangler.jsonc",
    "dev:site": "wrangler dev -c site/wrangler.jsonc",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply program-cue-db --local -c wrangler.development.jsonc",
    "db:migrate:e2e": "node scripts/migrate-e2e.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply program-cue-db-wnam --remote -c wrangler.jsonc",
    "db:bootstrap:production": "node scripts/bootstrap-production.mjs",
    "evaluation:fixture:reset": "node scripts/reset-production-evaluation-fixture.mjs",
    "backup:d1": "node scripts/export-d1-backup.mjs",
    "recovery:drill": "node scripts/verify-recovery.mjs"
  },
  "dependencies": {
    "@babel/core": "8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/react": "^7.0.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@scalar/api-reference-react": "^0.9.63",
    "@tanstack/react-table": "9.1.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "agents": "0.21.0",
    "ai": "7.0.70",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "ical-generator": "^11.1.0",
    "isbot": "^5",
    "lucide-react": "^1.33.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.9.2",
    "react-hook-form": "^7.85.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-router": "^8.3.0",
    "sonner": "2.0.8",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.9",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "msw": "^2.15.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
